node_modules/
dist/
.vercel/

# npm's default cache lives in ~/.npm, which the agent sandbox blocks. Point
# npm at a cache inside the workspace instead, so `npm install` works here:
#   npm --cache .npm-cache install
.npm-cache/

# Vercel CLI installed locally (a global install writes outside the workspace,
# which the sandbox blocks). Run it as ./.vercel-cli/node_modules/.bin/vercel
.vercel-cli/

# Short-lived deploy credential. The CLI's own OAuth token cannot be used from
# the agent sandbox (it must write refreshed tokens outside the workspace), so a
# Personal Access Token is supplied here instead. Delete it when the deploy is
# done, and revoke the token in Vercel.
.vercel-token

# Real environment files at any level; only the template is tracked.
.env
.env.*
!.env.example
*.env
*.env.*
!*.env.example

*.log
spike-out/
.DS_Store

# Local paid-spike fixtures: game screenshots used as spike input, not build
# inputs. Kept out of the public repo so it does not accumulate game art and
# multi-megabyte PNGs; the README documents the path for running the spike.
test-dresses/
