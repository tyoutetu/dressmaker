# Copy to api/.env for local `vercel dev` / scripts. Real .env files are ignored
# by git; this template holds empty or safe placeholder values only.

# ---- AI provider -----------------------------------------------------------
# qwen (default) | gemini | openai
AI_PROVIDER=qwen

# Qwen Image via the OpenAI-compatible images endpoint. The adapter appends
# /compatible-mode/v1/images/generations itself.
#
# Two platforms serve the same contract and both are allowlisted; the key decides
# which one works, and the keys are NOT interchangeable:
#   https://maas.qianwenaiapi.com   千问AI平台 / QwenCloud — keys start with sk-ws-
#                                   (create one at platform.qianwenai.com/home/api-keys)
#   https://<workspace>.cn-beijing.maas.aliyuncs.com
#                                   阿里云百炼 / Model Studio — keys start with sk-
#                                   Use the WORKSPACE-SCOPED host: plain
#                                   https://dashscope.aliyuncs.com answers chat
#                                   completions but returns 404 for the images route.
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://maas.qianwenaiapi.com
QWEN_IMAGE_MODEL=qwen-image-3.0

# Both of these are OFF by default and are sent explicitly on every request,
# because the platform turns them ON when the fields are absent:
#   prompt_extend   — lets the model rewrite the prompt, which can soften the
#                     "do not redesign the dress" constraints this tool relies on.
#   enable_thinking — improves quality but "increases generation time", and a
#                     timed-out attempt is still charged and never refunded.
# Set a value to true to opt back in. Thinking only takes effect while prompt
# extend is on, so asking for thinking without it fails closed instead of being
# silently ignored.
QWEN_PROMPT_EXTEND=false
QWEN_ENABLE_THINKING=false

# Swappable alternatives (only needed if AI_PROVIDER selects them)
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_QUALITY=medium

# ---- Cost control ----------------------------------------------------------
# Authoritative per-network ceiling per UTC day. Shared networks share it.
# Product maximum is 3: lower it (or set 0 to disable) but a value above 3 is
# rejected and the API fails closed.
USER_DAILY_GENERATION_LIMIT=3
# Optional: exact addresses that skip the per-network ceiling (for the operator
# testing their own deployment). Everyone else keeps the ceiling above, and the
# global budget still applies, so this cannot raise the day's worst-case spend.
# Comma-separated, exact match only. Leave empty and nobody is exempt.
QUOTA_UNLIMITED_IPS=
# Global ceiling across all visitors per UTC day. Set 0 to disable paid
# generation entirely (kill switch). Missing database/secret also fails closed.
GLOBAL_DAILY_GENERATION_LIMIT=100
# HMAC key for hashing client IPs (>= 16 chars). Required in production.
IP_HASH_SECRET=
# Local development only: when VERCEL is not 1, allow a loopback identity so the
# quota can be exercised without the platform header. Never set this on Vercel.
ALLOW_LOCAL_QUOTA_MODE=false

# ---- Storage ---------------------------------------------------------------
DATABASE_URL=

# ---- Usage stats -----------------------------------------------------------
# Enables GET /api/stats, which reports aggregate usage (networks, attempts,
# successes, estimated spend). Unset = the endpoint answers 404, which is the
# default: there is no development fallback, because a guessable token on a
# public URL is the same as no token. Use at least 16 characters.
# Read it with either `?token=...` (convenient in a browser, but the token then
# lands in browser history and in platform request logs) or an
# `Authorization: Bearer ...` header (what a script should use).
STATS_TOKEN=

# ---- HTTP ------------------------------------------------------------------
# Comma-separated browser origins allowed to call the API (no trailing slash).
ALLOWED_ORIGINS=

# ---- Limits ----------------------------------------------------------------
MAX_UPLOAD_BYTES=4194304
MAX_IMAGE_DIMENSION=4096
MAX_OUTPUT_BYTES=2600000
GENERATION_TIMEOUT_MS=240000

# Ops-only USD cost estimates, never shown to visitors. Leave a value blank to
# record NULL instead of inventing a price. Decimals are preserved (e.g. 0.03).
ESTIMATED_COST_QWEN_PER_IMAGE_USD=
ESTIMATED_COST_GEMINI_PER_IMAGE_USD=
ESTIMATED_COST_OPENAI_PER_IMAGE_USD=
