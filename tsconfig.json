{
  "compilerOptions": {
    "target": "ES2022",
    // NodeNext, not Bundler: these files are deployed as individual ESM modules
    // and run by Node, which does NOT infer file extensions. Bundler resolution
    // accepts `../lib/env` and then the function dies at runtime with
    // ERR_MODULE_NOT_FOUND — so the compiler is pinned to the runtime's rules and
    // the `.js` extensions are enforced here instead of discovered in production.
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": ["api", "lib", "scripts", "tests"]
}
